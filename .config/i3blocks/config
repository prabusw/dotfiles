# markup=pango

# This block is present to ensure that time appears in the center of the bar
[spaceblock]
full_text=" "
# The below to be used for scale 1.25
min_width=640
# The below to be used for scale 1
# min_width=800
# min_width=500
# min_width=350
align=center

[backup]
# command=/usr/local/bin/btrbk_status.sh
interval=once
signal=5

[mediaplayer]
interval=60
signal=2
min_width=20

# [mpd]
# interval=once
