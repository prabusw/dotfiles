# i3blocks configuration file
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks

# Global properties
# separator=true
align=center
separator=false
align=center
# color=#f8f8f2
separator_block_width=15
markup=pango
# $SCRIPT_DIR set in status_command in sway config file
command=$SCRIPT_DIR/$BLOCK_NAME

# [active]
# command=swaymsg -t subscribe -m '["window"]' | jq -r '.container.name'
# interval=once

[calendar]
command=slclock "%H:%M" "" --action
interval=persist
# DATEFMT=+%H:%M
LABEL=
CLICK_SCRIPT=/home/prabu/.config/sway/scripts/i3blocks/calendar
signal=4
# # Fancy text with multiple colors and shapes
