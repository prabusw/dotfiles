#!/bin/sh

# Define your light and dark theme names
DARK_THEME="Nordic"
LIGHT_THEME="Adwaita"

# Define sway config paths
SWAY_CONFIG_DIR="$HOME/.config/sway"
THEMES_DIR="$SWAY_CONFIG_DIR/themes"
DARK_SWAY_CONFIG="$THEMES_DIR/nord.conf"
LIGHT_SWAY_CONFIG="$THEMES_DIR/adwaita.conf"
GTK3_CONFIG="$HOME/.config/gtk-3.0/settings.ini"

apply_gtk_theme() {
    local theme=$1
    local color_scheme=$2

    # Update D-Bus for modern apps
    gsettings set org.gnome.desktop.interface gtk-theme "$theme"
    gsettings set org.gnome.desktop.interface color-scheme "$color_scheme"

    # Update physical config for legacy apps
    if [ -f "$GTK3_CONFIG" ]; then
        sed -i "s/^gtk-theme-name=.*/gtk-theme-name=$theme/" "$GTK3_CONFIG"
    fi
}

apply_sway_theme() {
    local theme_file="$1"
    local target="$SWAY_CONFIG_DIR/current_theme.conf"

    if [ -f "$theme_file" ]; then
        # -s: symbolic, -f: force (overwrites existing link)
        ln -sf "$theme_file" "$target"

        swaymsg reload
        logger "Symlinked $theme_file to $target"
    fi
}

set_dark_theme() {
    echo "Switching to dark theme ($DARK_THEME)..."
    apply_gtk_theme "$DARK_THEME" "prefer-dark"
    apply_sway_theme "$DARK_SWAY_CONFIG"
	pkill -SIGUSR1 foot
}

set_light_theme() {
    echo "Switching to light theme ($LIGHT_THEME)..."
    apply_gtk_theme "$LIGHT_THEME" "prefer-light"
    apply_sway_theme "$LIGHT_SWAY_CONFIG"
	pkill -SIGUSR2 foot
}

# Initialize sway with dark theme
if [ "$1" = "init" ]; then
    logger "Sway Init: Forcing dark theme"
    set_dark_theme
    exit 0
fi

# Normal toggle logic
CURRENT_GTK_THEME=$(gsettings get org.gnome.desktop.interface gtk-theme)
CURRENT_GTK_THEME=$(echo "$CURRENT_GTK_THEME" | tr -d "'")

if [ "$CURRENT_GTK_THEME" = "$DARK_THEME" ]; then
    set_light_theme
else
    set_dark_theme
fi
