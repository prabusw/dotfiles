#!/bin/sh
# This file is maintained as a literate file in
# 20240317205837-swaywm.org.
set -e
set -u

selection=$(
    printf "Suspend🌙\nLock🔒\nExit \nReboot\nPowerOff\n " |
    # printf "Suspend\nLock\nExit\nReboot\nPowerOff\n " |
        tofi --prompt-text="" \
             --hide-input=true \
             --hide-cursor=true \
             --font "Symbols Nerd Font:size=14"\
             --require-match=true\
             --auto-accept-single=true
         )

case "${selection}" in
	*"Lock"*)
		swaylockd
		;;
	*"Exit"*)
		swaymsg exit
		;;
	*"Suspend"*)
		powerctl mem
		pkill -SIGUSR2 wayeyes
		swaylockd
		;;
	*"Reboot"*)
		doas /sbin/reboot
		;;
	*"PowerOff"*)
		doas /sbin/poweroff
		;;
esac
