#!/usr/bin/env sh
WOBSOCK="${XDG_RUNTIME_DIR}/wob.sock"
get_volume(){
    volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@)
	volume_decimal=$(echo "$volume" | awk '/Volume/ {print $2}')
	volumep=$(echo "$volume_decimal * 100" | bc | awk '{printf "%d", $1}')
	if echo "$volume" | grep -q '[Mm]UTED'; then
        muted=1
    else
        muted=0
    fi
}

case "$1" in
    "0")
        # Toggle mute status
        wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
        ;;
    "+")
        # Unmute if needed and Increase volume by 5% (0.05)
		wpctl set-mute @DEFAULT_AUDIO_SINK@ 0
		wpctl set-volume @DEFAULT_AUDIO_SINK@ "0.05+" -l 1.0
        ;;
    "-")
        # Decrease volume by 5% (0.05)
        wpctl set-volume @DEFAULT_AUDIO_SINK@ "0.05-" -l 1.0
        ;;
esac
get_volume
if [ "$muted" -eq 1 ]; then
    echo "$volumep muted" > "$WOBSOCK"
else
    echo "$volumep" > "$WOBSOCK"
fi
pkill -RTMIN+1 i3blocks &
