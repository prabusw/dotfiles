#!/sbin/openrc-run

description="Screen blanker service for Wayland to protect your eyes"
command="$HOME/.local/bin/wayeyes"
supervisor=supervise-daemon
error_logger="logger -t '${RC_SVCNAME}' -p daemon.error"
