# output_log="$(eval echo ~$RC_RUNUSER)/.local/share/wayeyes/logs/openrc.out"
# error_log="$(eval echo ~$RC_RUNUSER)/.local/share/wayeyes/logs/openrc.err"

depends() {
	use dbus
}
