#
# ~/.ashrc : interactive shell configuration for BusyBox Ash
#

# Custom Aliases
alias ls='ls --color=auto'

# Alias definitions.
# You may want to put all your additions into a separate file like
# ~/.ash_aliases, instead of adding them here directly.

if [ -f ~/.ash_aliases ]; then
    . ~/.ash_aliases
fi

# Your /etc/profile already sets a PS1, but you can override or customize here.
# For example, to include the current time:
# export PS1='\t \u@\h:\w\$ ' # HH:MM:SS user@host:cwd$
